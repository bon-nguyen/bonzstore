# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bonzstore_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API (apps/api)
API_PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bonzstore_db?schema=public"
JWT_SECRET="bonzstore-super-secret-jwt-access-key-2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="bonzstore-super-secret-jwt-refresh-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Admin Dashboard (apps/dashboard - Vite)
VITE_API_URL="http://localhost:4000/api"

# Storefront Web (apps/web - Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

